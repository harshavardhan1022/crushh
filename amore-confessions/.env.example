# ============================================================================
# Anonymous College Confessions
# Environment Variables Configuration
# ============================================================================

# Supabase Configuration
# Found in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Keep this secret! Never expose on frontend)
# Found in: Supabase Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Initial Administrator Provisioning
ADMIN_EMAIL=admin@college.edu
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password-at-least-12-chars!

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

